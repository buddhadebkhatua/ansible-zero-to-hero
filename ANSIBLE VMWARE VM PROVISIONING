cd ~/vmware-automation
source .venv/bin/activate
 
ansible-playbook -i inventory.ini create_vms.yml --syntax-check
ansible-playbook -i inventory.ini create_vms.yml --ask-vault-pass

Where supported, use check mode first to inspect potential changes; VMware module check-mode behavior may not predict every clone/customization operation, so it is not a substitute for review.
12. Single VM deployment on a Distributed Switch
Use this workflow when one VM must be connected to a named distributed virtual switch and distributed port group. The port group name is supplied as the network name; dvswitch_name identifies the distributed switch.
12.1 Variables
# vars.yml - single VM example
vcenter_hostname: "vcenter.example.local"
vcenter_datacenter: "Datacenter1"
vcenter_cluster: "Cluster1"
vcenter_datastore: "Datastore1"
vm_template: "rocky-9-template"
 
vds_name: "DSwitch-Prod"
vds_portgroup: "DPG-VLAN100"
 
vm_name: "app-node-01"
vm_ip: "10.2.4.80"
vm_netmask: "255.255.0.0"
vm_gateway: "10.2.50.1"
vm_cpu: 2
vm_ram_mb: 4096
vm_disk_gb: 40
 
dns_servers:
  - "10.2.0.10"
  - "10.2.0.11

12.2 Playbook
---
- name: Deploy one VM on a VMware Distributed Switch
  hosts: local
  gather_facts: false
 
  vars_files:
    - vars.yml
    - secrets.yml
 
  tasks:
    - name: Validate single VM variables
      ansible.builtin.assert:
        that:
          - vm_name | length > 0
          - vm_cpu | int > 0
          - vm_ram_mb | int > 0
          - vm_disk_gb | int > 0
          - vm_ip is defined
          - vds_name | length > 0
          - vds_portgroup | length > 0
 
    - name: Clone and configure VM on Distributed Switch
      community.vmware.vmware_guest:
        hostname: "{{ vcenter_hostname }}"
        username: "{{ vcenter_user }}"
        password: "{{ vcenter_pass }}"
        validate_certs: true
        datacenter: "{{ vcenter_datacenter }}"
        cluster: "{{ vcenter_cluster }}"
        datastore: "{{ vcenter_datastore }}"
        template: "{{ vm_template }}"
        name: "{{ vm_name }}"
        state: poweredon
        wait_for_ip_address: true
        wait_for_ip_address_timeout: 600
        wait_for_customization: true
        wait_for_customization_timeout: 600
        hardware:
          memory_mb: "{{ vm_ram_mb }}"
          num_cpus: "{{ vm_cpu }}"
          scsi: paravirtual
        disk:
          - size_gb: "{{ vm_disk_gb }}"
            type: thin
            datastore: "{{ vcenter_datastore }}"
        networks:
          - name: "{{ vds_portgroup }}"
            dvswitch_name: "{{ vds_name }}"
            ip: "{{ vm_ip }}"
            netmask: "{{ vm_netmask }}"
            gateway: "{{ vm_gateway }}"
            type: static
            connected: true
            start_connected: true
        customization:
          hostname: "{{ vm_name }}"
          dns_servers: "{{ dns_servers }}"
      register: vm_deploy_result
 
    - name: Display deployment details
      ansible.builtin.debug:
        msg: >-
          VM {{ vm_deploy_result.instance.hw_name | default(vm_name) }}
          reported IP {{ vm_deploy_result.instance.ipv4 | default('IP not reported') }}

12.3 Run
ansible-playbook -i inventory.ini create_single_vm_vds.yml --syntax-check
ansible-playbook -i inventory.ini create_single_vm_vds.yml --ask-vault-pass

13. Deployment validation
Perform these checks after every deployment. The automation output alone is not sufficient evidence of a fully operational VM.
Check	  ======================  Expected result	 ====================================    Evidence / command
vCenter inventory	    VM exists in intended datacenter/folder/cluster      	          Review VM inventory and task history
Power state	          Powered on	                                                    vCenter summary
Hardware	            CPU, RAM and disk match requested values	                      Edit Settings / VM Summary
NIC	                  Correct port group; connected and Connect at power on enabled	  VM hardware settings
Guest customization	  Customization completed successfully	                          vCenter Events/Tasks
Hostname	            Matches requested VM name                                    	  Guest console or SSH: hostnamectl
IP configuration	    Static address, mask and gateway match plan	                    ip addr; ip route
DNS	                  Configured resolvers and resolution works                      	resolvectl status; getent hosts
Network reachability	Gateway and approved destinations reachable	                    ping / traceroute as permitted
Remote access	        SSH or approved management access succeeds	                    SSH test from admin network
VMware Tools	        Running/healthy	                                                vCenter Guest Tools status; systemctl status vmtoolsd


