10. Multi-VM deployment playbook
This playbook clones each VM definition from the template, configures hardware, disk, network and guest customization, then reports the result. Review the task parameters and module version against the installed collection.
---
- name: Deploy multiple VMs in VMware vSphere
  hosts: local
  gather_facts: false
 
  vars_files:
    - vars.yml
    - secrets.yml
 
  tasks:
    - name: Validate VM definitions
      ansible.builtin.assert:
        that:
          - vms_to_create | length > 0
          - item.name | length > 0
          - item.cpu | int > 0
          - item.ram_mb | int > 0
          - item.disk_gb | int > 0
          - item.ip is defined
          - item.netmask is defined
          - item.gateway is defined
        fail_msg: "Invalid VM definition: {{ item.name | default('unnamed') }}"
      loop: "{{ vms_to_create }}"
 
    - name: Clone and configure VMs from template
      community.vmware.vmware_guest:
        hostname: "{{ vcenter_hostname }}"
        username: "{{ vcenter_user }}"
        password: "{{ vcenter_pass }}"
        validate_certs: true
        datacenter: "{{ vcenter_datacenter }}"
        cluster: "{{ vcenter_cluster }}"
        datastore: "{{ vcenter_datastore }}"
        template: "{{ vm_template }}"
        name: "{{ item.name }}"
        state: poweredon
        wait_for_ip_address: true
        wait_for_ip_address_timeout: 600
        wait_for_customization: true
        wait_for_customization_timeout: 600
        hardware:
          memory_mb: "{{ item.ram_mb }}"
          num_cpus: "{{ item.cpu }}"
          scsi: paravirtual
        disk:
          - size_gb: "{{ item.disk_gb }}"
            type: thin
            datastore: "{{ vcenter_datastore }}"
        networks:
          - name: "{{ vm_network }}"
            ip: "{{ item.ip }}"
            netmask: "{{ item.netmask }}"
            gateway: "{{ item.gateway }}"
            type: static
            connected: true
            start_connected: true
        customization:
          hostname: "{{ item.name }}"
          dns_servers: "{{ dns_servers }}"
      loop: "{{ vms_to_create }}"
      register: vm_deploy_result
 
    - name: Display VM deployment summary
      ansible.builtin.debug:
        msg: >-
          VM {{ item.item.name }} deployment task completed.
          Reported IP: {{ item.instance.ipv4 | default('IP not reported') }}
      loop: "{{ vm_deploy_result.results }}

Operational note: waiting for guest customization and IP reporting depends on VMware Tools and guest behavior. A timeout should be investigated rather than treated as proof that the VM was not created.
